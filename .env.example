# Browser-visible API base URL. Do not put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Hostname that serves the pre-GW1 Free beta and may expose the synthetic squad.
NEXT_PUBLIC_APP_HOST=app.gaffertalk.com

# Public Turnstile widget key for the pre-launch waitlist. Safe for browser use.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret Turnstile verification key. Configure only in local secrets or Cloudflare.
TURNSTILE_SECRET_KEY=

# Comma-separated browser origins accepted by the local API.
GAFFERTALK_CORS_ORIGINS=http://localhost:3000
GAFFERTALK_ENVIRONMENT=development

# Public FPL integration. Override only for testing or an approved proxy.
GAFFERTALK_FPL_BASE_URL=https://fantasy.premierleague.com/api/
GAFFERTALK_FPL_TIMEOUT_SECONDS=8
GAFFERTALK_FPL_MAX_ATTEMPTS=3

# Server-only Groq configuration. Never prefix this key with NEXT_PUBLIC or commit a real value.
GAFFERTALK_GROQ_API_KEY=
GAFFERTALK_GROQ_MODEL=openai/gpt-oss-20b
GAFFERTALK_GROQ_BASE_URL=https://api.groq.com/openai/v1/
GAFFERTALK_GROQ_TIMEOUT_SECONDS=12

# Anonymous Free beta allowance. SQLite is suitable for one local/API instance.
GAFFERTALK_FREE_QUESTION_LIMIT=3
GAFFERTALK_FREE_USAGE_DATABASE_PATH=.data/gaffertalk.sqlite3

# Railway staging uses these values instead:
# GAFFERTALK_ENVIRONMENT=staging
# GAFFERTALK_CORS_ORIGINS=https://gaffertalk.com,https://app.gaffertalk.com
# GAFFERTALK_FREE_USAGE_DATABASE_PATH=/data/gaffertalk.sqlite3
