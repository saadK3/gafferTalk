{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gaffertalk-web",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "gaffertalk.com",
      "custom_domain": true
    },
    {
      "pattern": "app.gaffertalk.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gaffertalk-waitlist",
      "database_id": "2414d6b9-f30f-4d2a-a228-328ba5132fcc"
    }
  ]
}
